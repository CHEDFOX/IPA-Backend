# ---- Required ---------------------------------------------------------------

# The backend's domain (an A record pointing at this VPS). Caddy gets the HTTPS
# certificate for it automatically.
API_DOMAIN=api.yourdomain.com

# Password for the admin panel (at least 10 characters). Use something long.
ADMIN_PASSWORD=

# Public address of this backend, without a trailing slash. Photo and video
# links are built from it, e.g. https://api.yourdomain.com
PUBLIC_URL=https://api.yourdomain.com

# Public address of the website on Vercel, without a trailing slash. Before your
# domain is connected you can use the Vercel address, e.g. https://ipa-web.vercel.app
SITE_URL=https://yourdomain.com

# ---- Website refresh -------------------------------------------------------

# After you save a change in the admin, the backend asks the website to
# refresh its cached pages. Use the same secret in the website's settings.
WEB_REVALIDATE_URL=https://yourdomain.com/api/revalidate
REVALIDATE_SECRET=

# ---- Optional --------------------------------------------------------------

# Port and interface to listen on. Keep 127.0.0.1 behind nginx/Caddy.
PORT=4000
HOST=127.0.0.1

# Where the database and uploaded files live. Back this folder up.
DATA_DIR=./data

# Website addresses allowed to send the enquiry form (comma separated).
# Defaults to the origin of SITE_URL.
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Largest single upload in MB (big drone videos need room). Match nginx's
# client_max_body_size.
MAX_UPLOAD_MB=1024

# Keep the original photo files (not served, useful if you ever want to
# regenerate the web sizes). Set to false to save disk space.
KEEP_ORIGINALS=true

# Email me when someone sends an enquiry (leave empty to turn off).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# NOTIFY_EMAIL=you@yourdomain.com
# MAIL_FROM=Website <no-reply@yourdomain.com>
