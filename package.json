    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.6",
    "qrcode": "1.5",
    "sharp": "^0.35.5"
  }
}
