{
  "name": "ipa-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API, media server and admin panel for the IPA real estate & land portfolio site.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
