# Used by the caddy service in docker-compose.yml. Caddy gets and renews the
# HTTPS certificate for API_DOMAIN by itself.
{$API_DOMAIN} {
	# Big enough for drone videos; keep in step with MAX_UPLOAD_MB.
	request_body {
		max_size 1GB
	}

	# Photos and videos straight from disk: fast, cacheable, supports video seeking.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		header Access-Control-Allow-Origin "*"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	reverse_proxy {$BACKEND_UPSTREAM:backend:4000}
}
