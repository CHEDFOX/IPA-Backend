# Alternative to nginx: Caddy gets HTTPS certificates automatically.
api.yourdomain.com {
    request_body {
        max_size 1GB
    }
    handle_path /media/* {
        root * /opt/ipa-backend/data/media
        header Cache-Control "public, max-age=31536000, immutable"
        header Access-Control-Allow-Origin "*"
        file_server
    }
    reverse_proxy 127.0.0.1:4000
}
